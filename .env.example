# Kopie als .env neben der docker-compose.yml ablegen und ausfuellen.
# Die Datei ist per .gitignore ausgenommen - der App-Key gehoert nicht ins Repository.

# Adresse der Hue-Bridge (Hue-App: Einstellungen -> Hue Bridges -> i)
HUE_BRIDGE_IP=192.168.1.42

# App-Key der Bridge, siehe README "App-Key besorgen"
HUE_APP_KEY=

# Quellen ein- oder ausschalten; leer = es gilt config/meters.json
HUE_ENABLED=
SONOS_ENABLED=
